{
  "name": "linkssaver",
  "version": "2.1.0",
  "description": "Link saver with smart auto-tagging",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test",
    "pack": "electron-builder --dir --publish=never",
    "build": "electron-builder --publish=never",
    "build:mac": "electron-builder --mac --publish=never",
    "build:win": "electron-builder --win --publish=never",
    "build:linux": "electron-builder --linux --publish=never",
    "build:release:mac": "electron-builder --mac --publish=never --config.forceCodeSigning=true --config.mac.notarize=true --config.mac.hardenedRuntime=true",
    "build:release:win": "electron-builder --win --publish=never --config.forceCodeSigning=true",
    "screenshots": "electron scripts/capture-screenshots.mjs",
    "postinstall": "electron-builder install-app-deps",
    "clean": "node scripts/clean.mjs"
  },
  "keywords": [
    "electron",
    "links",
    "bookmarks",
    "productivity",
    "ai"
  ],
  "author": "nikita9",
  "license": "MIT",
  "homepage": "https://github.com/nikita9/LinkSaver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikita9/LinkSaver.git"
  },
  "bugs": {
    "url": "https://github.com/nikita9/LinkSaver/issues"
  },
  "engines": {
    "node": "^22.13.0 || >=24",
    "npm": ">=10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1"
  },
  "build": {
    "appId": "com.linksaver.app",
    "productName": "Link Saver",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "nikita9 <1824410+nikita9@users.noreply.github.com>",
      "category": "Utility",
      "executableName": "link-saver",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Link.Saver-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Link.Saver-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Link.Saver-Portable-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Link.Saver-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "Link.Saver-${version}-linux-${arch}.${ext}"
    }
  }
}
